<UserControl x:Class="WinDeutsch.App.Cards.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{Binding FontFamily}"
             Foreground="{Binding TextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI Emoji" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40808080" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="FontSize" Value="{Binding DataContext.SmallFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,3">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" Background="{Binding BackgroundBrush}" Padding="10,6">
        <Grid>
            <!-- Phrase -->
            <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowPhrase, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding German}" FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Russian}" FontSize="{Binding TranslationFontSize}" Opacity="0.8" TextWrapping="Wrap"
                           Visibility="{Binding ShowTranslation, Converter={StaticResource Vis}}" />
            </StackPanel>

            <!-- Quiz -->
            <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowQuiz, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding German}" FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Что это означает?" FontSize="{Binding SmallFontSize}" Opacity="0.75" Margin="0,2,0,2" />
                <ItemsControl ItemsSource="{Binding QuizOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OptionButton}" Background="{Binding Background}" Tag="{Binding Index}"
                                    Click="OnOptionClick">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock HorizontalAlignment="Right" Margin="0,2,2,0" FontSize="{Binding SmallFontSize}" Opacity="0.75">
                    <Hyperlink Foreground="{Binding TextBrush}" Click="OnDontKnowClick">Не знаю</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- No phrases -->
            <TextBlock Text="{Binding EmptyText}" FontSize="{Binding TranslationFontSize}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Cursor="Hand" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}" />

            <!-- Paused -->
            <DockPanel VerticalAlignment="Center" Visibility="{Binding ShowPaused, Converter={StaticResource Vis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="▶" ToolTip="Продолжить" Click="OnResumeClick" />
                <TextBlock Text="{Binding PausedText}" FontSize="{Binding TranslationFontSize}" Opacity="0.55" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Controls -->
            <Border x:Name="ControlsBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="4" Margin="0,0,-6,-4"
                    Background="{Binding BackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="◀" ToolTip="Предыдущая" IsEnabled="{Binding CanGoBack}" Click="OnPreviousClick" />
                    <Button Style="{StaticResource IconButton}" Content="▶" ToolTip="Следующая" Click="OnNextClick" />
                    <Button Style="{StaticResource IconButton}" Content="👁" ToolTip="Показать перевод" Click="OnRevealClick"
                            Visibility="{Binding CanReveal, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource IconButton}" Content="✓" ToolTip="Знаю" Click="OnKnownClick" />
                    <Button Style="{StaticResource IconButton}" Content="✗" ToolTip="Не знаю" Click="OnUnknownClick" />
                    <Button Style="{StaticResource IconButton}" Content="⏰" ToolTip="Позже (через час)" Click="OnLaterClick" />
                    <Button Style="{StaticResource IconButton}" Content="⏸" ToolTip="Пауза" Click="OnPauseClick" />
                    <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="Скрыть" Click="OnCloseClick" />
                    <Button Style="{StaticResource IconButton}" Content="⋯" ToolTip="Ещё" Click="OnMoreClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
